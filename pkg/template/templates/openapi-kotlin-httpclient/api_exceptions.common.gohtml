{{- /*gotype: github.com/primelib/primecodegen/pkg/openapi/openapigenerator.APIOnceTemplate*/ -}}
{{- template "header-singleline" }}

package {{ .Common.Packages.Client }}

/**
 * Thrown when a request could not be performed, e.g. due to I/O, timeout or (de)serialization errors.
 */
class ApiClientException(
    message: String,
    cause: Throwable? = null
) : RuntimeException(message, cause)

/**
 * Thrown when the API responds with an error status code (4xx/5xx) and failOnError is enabled.
 */
class ApiResponseException(
    val statusCode: Int,
    val responseBody: String?,
    val responseHeaders: Map<String, List<String>>
) : RuntimeException("Request failed with status $statusCode") {
    /**
     * @return the first value of the given response header (case-insensitive), or null if not present
     */
    fun getResponseHeader(name: String): String? =
        responseHeaders.entries.firstOrNull { it.key.equals(name, ignoreCase = true) }?.value?.firstOrNull()
}
