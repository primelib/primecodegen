    @Nullable
    default String header(String name) {
        return headers().entrySet().stream()
            .filter(e -> e.getKey() != null && e.getKey().equalsIgnoreCase(name))
            .map(Map.Entry::getValue)
            .filter(values -> values != null && !values.isEmpty())
